<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network & Loopback Proxy Relay permissions (Normal, install-time) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Optional Foreground Service & Notification for Persistent Sandbox Monitor -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Play-policy compliant app discovery for launchable installed apps -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".CloneCoreApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CloneCore">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:label="@string/app_name"
            android:theme="@style/Theme.CloneCore">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deep-Link Integration for individual cloned sessions -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="clonecore" android:host="session" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="clonecore.app"
                    android:pathPrefix="/s/" />
            </intent-filter>
        </activity>

        <!-- Dedicated app processes for workspace state; same UID, not a security boundary. -->
        <service
            android:name=".engine.process.SandboxSlot0Service"
            android:exported="false"
            android:process=":sandbox_p0" />
        <service
            android:name=".engine.process.SandboxSlot1Service"
            android:exported="false"
            android:process=":sandbox_p1" />
        <service
            android:name=".engine.process.SandboxSlot2Service"
            android:exported="false"
            android:process=":sandbox_p2" />
        <service
            android:name=".engine.process.SandboxSlot3Service"
            android:exported="false"
            android:process=":sandbox_p3" />

        <!-- Persistent Sandbox Telemetry & Proxy Rotation Foreground Service -->
        <service
            android:name=".engine.process.SandboxMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>
